# Production .env for the Zeronix Frappe/ERPNext/CRM VPS deployment.
# Copy to .env on the server (/srv/docker/frappe/.env), fill in real values,
# then: chmod 600 .env
# Never commit the real .env file.

# Built locally on the VPS from apps.json (see PRODUCTION.md) - not pulled
# from Docker Hub, so PULL_POLICY must be "missing" or compose will try to
# pull an image that doesn't exist on any registry.
CUSTOM_IMAGE=zeronix-frappe
CUSTOM_TAG=16
PULL_POLICY=missing

# MariaDB root password - used by configurator and create-site.
# Generate with: openssl rand -hex 24
DB_PASSWORD=

# Administrator password for the ERPNext/CRM site.
# Generate with: openssl rand -hex 16
ADMIN_PASSWORD=

# The single site this stack serves.
SITE_NAME=zeronixos.online

# Both zeronixos.online and www.zeronixos.online are reverse-proxied to the
# same frontend container with their original Host header intact (per the
# Caddy block in PRODUCTION.md). Since only one site exists, pin nginx to
# always serve it regardless of which of the two hostnames was requested,
# instead of the default $$host-based site lookup.
FRAPPE_SITE_NAME_HEADER=zeronixos.online

# Required by overrides/compose.migrator.yaml - runs `bench --site all
# migrate` automatically every `docker compose up -d`. Keep true.
MIGRATE_SITES=true

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
